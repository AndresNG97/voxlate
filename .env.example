# --- Modo audio (fase 2, beta) ---
# Apagado por defecto: la build normal (la de la Chrome Web Store) no incluye
# Deepgram ni pide tabCapture/activeTab/scripting. Ponlo a true para incluirlo.
WXT_LIVE_MODE=false

# En producción la extensión pide un token temporal a TU backend.
# El backend tiene la API key de Deepgram y devuelve: { "access_token": "...", "expires_in": 30 }
WXT_STT_TOKEN_URL=

# SOLO PARA DESARROLLO LOCAL: API key de Deepgram metida en el bundle.
# Nunca publiques una build con esto relleno: cualquiera puede extraerla.
# (pnpm build falla si la clave aparece en la build de producción).
WXT_DEEPGRAM_DEV_KEY=
